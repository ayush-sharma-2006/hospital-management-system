<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_past_appointments</fullName>
    <active>true</active>
    <errorConditionFormula>Appointment_Date__c &lt; TODAY()</errorConditionFormula>
    <errorMessage>Appointment date cannot be in the past.</errorMessage>
</ValidationRule>
